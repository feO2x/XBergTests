<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsTestProject>true</IsTestProject>
        <Nullable>enable</Nullable>
        <!--
          XbergIo.Xberg ships its native library (xberg_ffi) in separate RID-specific
          packages that are pulled in through the package's runtime.json. NuGet only
          walks runtime.json when the project declares a RID, so without this the
          restore silently produces a managed-only output and the first P/Invoke fails
          with DllNotFoundException.

          NETCoreSdkPortableRuntimeIdentifier is the RID of the SDK doing the build
          (osx-arm64, linux-x64, win-x64, ...), so every developer machine and CI
          runner restores exactly the one native package it needs.
        -->
        <RuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
        <SelfContained>false</SelfContained>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="XbergIo.Xberg" Version="1.1.2" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Update="Files/**/*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
